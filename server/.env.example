# Xiaozhi Server - Environment Variables
# Copy this file to .env and fill in your API keys

# LLM (DeepSeek)
DEEPSEEK_API_KEY=sk-your-deepseek-key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# STT (OpenAI Whisper)
STT_API_KEY=sk-your-openai-key
STT_BASE_URL=https://api.openai.com/v1
STT_MODEL=whisper-1

# TTS (MiMo)
TTS_API_KEY=your-mimo-key

# System prompt (optional — defaults to built-in Reddy prompt)
# SYSTEM_PROMPT=你是一个给6岁小男孩用的语音助手...

# Server
XZ_HOST=0.0.0.0
XZ_PORT=7070
